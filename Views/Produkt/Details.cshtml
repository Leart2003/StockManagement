@using Microsoft.AspNetCore.Identity
@model PunimDiplome.Domain.Entities.ProduktDetailsVM
@inject UserManager<IdentityUser> userManager

@{
    ViewData["Title"] = "Product Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
}

<!-- Details Hero -->
<section class="details-hero">
    <div class="container px-4 px-lg-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Produkt" asp-action="Index">Products</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Produkt?.Name</li>
            </ol>
        </nav>
    </div>
</section>

<div class="container px-4 px-lg-5 py-4">
    <div class="row">
        <!-- Product Image -->
        <div class="col-lg-6 mb-4">
            <div class="product-image-container">
                <img src="~/Produktet/@Model.Produkt?.ImageFileName" alt="@Model.Produkt?.Name" class="product-image" id="mainImage">
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-lg-6">
            <!-- Title and Brand -->
            <div class="specs-card">
                <p class="text-muted mb-2">@Model.Produkt?.Brand</p>
                <h1 class="mb-3">@Model.Produkt?.Name</h1>
                <p class="text-muted mb-0">@Model.Produkt?.Category</p>
            </div>

            <!-- Price Section -->
            <div class="price-section">
                <div class="price-display">@Model.Produkt?.Price.ToString("C")</div>
                <div class="rating">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-half"></i>
                    <span class="ms-2">4.5 (120 reviews)</span>
                </div>
            </div>

            <!-- Description -->
            <div class="description-section">
                <h5>Product Description</h5>
                <p>@Model.Produkt?.Description</p>
            </div>

            <!-- Key Specifications -->
            <div class="specs-card">
                <h5 class="mb-3">Key Specifications</h5>
                <div class="spec-item">
                    <span class="spec-label"><i class="bi bi-cpu"></i> Processor</span>
                    <span class="spec-value">@Model.Produkt?.Procesor</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label"><i class="bi bi-memory"></i> RAM</span>
                    <span class="spec-value">@Model.Produkt?.Ram</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label"><i class="bi bi-hdd"></i> Storage</span>
                    <span class="spec-value">@Model.Produkt?.Storage @Model.Produkt?.Storagetype</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label"><i class="bi bi-display"></i> Screen Size</span>
                    <span class="spec-value">@Model.Produkt?.ScreenInch</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label"><i class="bi bi-calendar-event"></i> Manufactured Date</span>
                    <span class="spec-value">@Model.Produkt?.Date.ToString("yyyy-MM-dd")</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Order" asp-action="OrderForm" asp-route-productId="@Model.Produkt?.Id" class="btn btn-primary btn-order">
                        <i class="bi bi-cart-plus"></i> Order Now
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-order">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                }
                else
                {
                    <div class="auth-required-message w-100">
                        <i class="bi bi-info-circle"></i> Please <a asp-area="Identity" asp-page="/Account/Login">login</a> to place an order
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Comments Section -->
    <div class="comments-section">
        <h4><i class="bi bi-chat-left-text"></i> Customer Comments</h4>

        @if (Model.Koments?.Any() == true)
        {
            <div class="mb-4">
                @foreach (var koment in Model.Koments)
                {
                    <div class="comment">
                        <div class="comment-header">
                            <span class="comment-author">
                                <i class="bi bi-person-circle"></i> @koment.User?.UserName
                            </span>
                            @if (User.Identity.IsAuthenticated && koment.IdentityUserId == userManager.GetUserId(User))
                            {
                                <form method="post" asp-controller="Produkt" asp-action="DeleteComment" class="m-0 d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@koment.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </div>
                        <p class="comment-content">@koment.Content</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="auth-required-message">
                <i class="bi bi-chat-left-dots"></i> No comments yet. Be the first to comment!
            </div>
        }

        <!-- Add Comment Form -->
        <div class="comment-form">
            <h5 class="mb-3">Leave a Comment</h5>
            @if (User.Identity.IsAuthenticated)
            {
                <form asp-action="AddComment" asp-controller="Produkt" method="post">
                    <div class="mb-3">
                        <label for="Content" class="form-label">Your Comment</label>
                        <textarea id="Content" name="Content" class="form-control" rows="4" placeholder="Share your thoughts about this product..." required></textarea>
                    </div>
                    <input type="hidden" name="ProduktId" value="@Model.Produkt?.Id" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Post Comment
                    </button>
                </form>
            }
            else
            {
                <div class="auth-required-message">
                    <i class="bi bi-lock"></i> Please <a asp-area="Identity" asp-page="/Account/Login">login</a> to add a comment
                </div>
            }
        </div>
    </div>
</div>
